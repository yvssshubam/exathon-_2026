# Copy to .env and fill in from `exasol info` (requirements s7: do not hard-code the port).
# DSN is host:port, e.g. localhost:8563 (check `exasol info`; it may also print a certificate fingerprint).
EXA_DSN=localhost:8563
EXA_USER=sys
EXA_PASSWORD=exasol
# Exasol Personal uses a self-signed certificate locally. Leave false locally; true for a real deployment.
EXA_VERIFY_CERT=false
# Optional: certificate fingerprint from `exasol info`, appended to the DSN by pipeline/db.py when set.
EXA_FINGERPRINT=
# The admin user above builds the schemas (`make db`) and runs the narrator's view. Everything else logs in as its own
# user, created by `make db` with this password: PH_X_MAKER / PH_X_CHECKER (and Y, Z) and PH_PORTAL_SVC.
# Pick any password; it stays on your machine.
PH_ROLE_PASSWORD=
# The bank whose console and CLI commands you use by default (the console is Bank X's nodal desk)
OWN_BANK_ID=BANK_X

# Optional: let a local model orchestrate the agent and word the summaries (free, offline). Off by default;
# the fixed order does the same work. Install Ollama, then: ollama pull qwen2.5:7b
PH_LLM=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b