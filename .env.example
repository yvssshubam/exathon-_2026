# Copy to .env and fill in from `exasol info` (requirements s7: do not hard-code the port).
# DSN is host:port, e.g. localhost:8563 (check `exasol info`; it may also print a certificate fingerprint).
EXA_DSN=localhost:8563
EXA_USER=sys
EXA_PASSWORD=exasol
# Exasol Personal uses a self-signed certificate locally. Leave false locally; true for a real deployment.
EXA_VERIFY_CERT=false
# Optional: certificate fingerprint from `exasol info`, appended to the DSN by pipeline/db.py when set.
EXA_FINGERPRINT=
# The bank running the tool (requirements s8, table BANK)
OWN_BANK_ID=BANK_X